{
  "name": "s1sdk",
  "version": "0.1.1",
  "description": "Zero-overhead System-1 decision client for discrete token/logit routing, calibrated probabilities, and least-cost execution",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olanigan/s1sdk.git"
  },
  "homepage": "https://github.com/olanigan/s1sdk#readme",
  "bugs": {
    "url": "https://github.com/olanigan/s1sdk/issues"
  },
  "files": [
    "dist",
    "src",
    "examples/*.ts",
    "examples/README.md",
    "examples/shared/*.ts",
    "examples/03-cloudflare-worker-customer-service/*.ts",
    "examples/03-cloudflare-worker-customer-service/*.jsonc",
    "skills",
    "scripts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && bun build src/index.ts --outfile dist/index.cjs --format cjs && bun build src/providers/index.ts --outfile dist/providers/index.cjs --format cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run check",
    "release:dry": "npm publish --dry-run --access public",
    "release": "bun run check && npm publish --access public",
    "devx": "bun run scripts/devx.ts",
    "doctor": "bun run scripts/devx.ts doctor",
    "smoke": "bun run scripts/devx.ts smoke",
    "example:quickstart": "bun run examples/00-quickstart.ts",
    "example:resilience": "bun run examples/04-offline-fallback-resilience.ts",
    "example:typesafe": "bun run examples/01-typesafe-customer-service.ts",
    "example:openrouter": "bun run examples/02-openrouter-customer-service.ts",
    "example:homerouter": "bun run examples/05-homerouter-v1-1-agentic-dispatch.ts",
    "example:clairic": "bun run examples/07-clairic-invoice-extraction.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "jev",
    "system-1",
    "typesafe-ai",
    "finops",
    "decision-router",
    "cloudflare-workers-ai",
    "openrouter"
  ],
  "author": "Homestead Labs",
  "license": "Apache-2.0"
}
