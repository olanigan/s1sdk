# s1sdk devx — copy to `.env` and fill in ONE group.
#
# Resolution order (first hit wins):
#   TypeSafe AI -> OpenRouter -> Cloudflare Workers AI -> local Ollama -> local Homestead
# Check what the resolver sees at any time with:  bun run devx doctor
#
# Only configure one of these to keep the choice unambiguous. Secrets are read
# from the process env, so shell exports always beat this file.

# ── Option 1: TypeSafe AI (lowest latency hosted path) ──────────────────────
# TYPESAFE_API_KEY=ts-...
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone

# ── Option 2: OpenRouter decisions API ──────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/alpha/decisions

# ── Option 3: Cloudflare Workers AI over REST ───────────────────────────────
# (inside a Worker, pass `binding: env.AI` instead — no token, zero egress)
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...

# ── Option 4: local Ollama (free, no key) ───────────────────────────────────
#   ollama serve
#   ollama pull tev1:0.8b
# OLLAMA_HOST=127.0.0.1:11434

# ── Option 5: local Homestead S1 daemon (free, no key) ──────────────────────
#   homestead serve homerouter
# HOMESTEAD_API_URL=http://127.0.0.1:8080
# HOMESTEAD_API_KEY=

# ── Optional tuning ─────────────────────────────────────────────────────────
# S1_PROVIDER=typesafe        # strict pin; no cross-provider fallback
# S1_MODEL=jev-latest         # override the provider default model
# S1_TIMEOUT_MS=10000         # Ollama first-call model load needs ~30000
# S1_KEEP_ALIVE=5m            # keep the local model resident between calls
# S1_SKIP_PROBE=1             # do not probe local daemons before selecting

# ── Publishing only ─────────────────────────────────────────────────────────
# NPM_TOKEN=npm_...           # never commit this; `npm login` also works
